# Copiez ce fichier en .env et adaptez.
# Connexion à votre PostgreSQL local (base créée avec : createdb -U postgres happy)
DATABASE_URL=postgres://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/happy

# Port de l'API. Depuis l'émulateur Android, l'app l'appelle via http://10.0.2.2:4000
PORT=4000

# Secret qui signe les jetons de connexion : mettez une longue phrase aléatoire
JWT_SECRET=change-moi-avec-une-longue-phrase-secrete

# Adresse publique utilisée dans les liens de partage (site web Happy)
SITE_URL=http://localhost:3000
