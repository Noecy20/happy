# Copiez ce fichier en `.env` puis renseignez les valeurs (Supabase > Project Settings > API).
# Seules des clés PUBLIQUES vont ici : jamais la clé service_role ni la clé VAPID privée.
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# URL publique du site web Happy (sans slash final). Sert aux liens de partage,
# aux routes /api (push, admin) et aux liens universels. Doit être joignable depuis le téléphone.
EXPO_PUBLIC_SITE_URL=https://happy.example.com
