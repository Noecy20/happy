# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# URL publique du site (sans slash final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sécurise la route cron quotidienne
CRON_SECRET=change-moi

# Optionnel : envoi d'emails via Resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="Happy <no-reply@votredomaine.com>"

# Notifications push gratuites (générez vos clés : npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:vous@exemple.com
